# Copy this file to .env and fill in the values.

SECRET_KEY=change-this-to-a-long-random-string
ADMIN_PASSWORD=choose-a-strong-admin-password

# Supabase (required for cloud sync across phones and computers)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=complaint-photos

# Optional: real Swachhata credentials when you have them
SWACHHATA_API_URL=https://api.swachh.city/sbm/v1
SWACHHATA_VENDOR_NAME=
SWACHHATA_ACCESS_KEY=
