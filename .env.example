# Copy this file to .env and fill in the values.

# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# development | production
APP_ENV=development

ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-admin-password

# Set true when serving over HTTPS (also send Secure session cookies + HSTS).
SESSION_HTTPS_ONLY=false

# Set true only if a reverse proxy sets X-Forwarded-For.
TRUST_PROXY=false

# Optional comma-separated hosts, e.g. nagardrishti.example.com,localhost
ALLOWED_HOSTS=

# Project URL from Supabase → Project Settings → Data API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# NOT the publishable / anon key.
# Use the Secret key (sb_secret_...) or legacy service_role JWT after clicking Reveal.
# This key stays on the server only. Never put it in the Android app or browser JS.
SUPABASE_SERVICE_KEY=paste-secret-or-service-role-here
SUPABASE_BUCKET=complaint-photos

# Optional: public URL of this FastAPI app (needed for APK on mobile data)
PUBLIC_APP_URL=

SWACHHATA_API_URL=https://api.swachh.city/sbm/v1
SWACHHATA_VENDOR_NAME=
SWACHHATA_ACCESS_KEY=
