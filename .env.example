# Copy this file to .env and fill in the values.

SECRET_KEY=change-this-to-a-long-random-string
ADMIN_PASSWORD=choose-a-strong-admin-password

# Project URL from Supabase → Project Settings → Data API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# NOT the publishable / anon key.
# Use the Secret key (sb_secret_...) or legacy service_role JWT after clicking Reveal.
# Supabase → Project Settings → API Keys
SUPABASE_SERVICE_KEY=paste-secret-or-service-role-here
SUPABASE_BUCKET=complaint-photos

# Optional: public URL of this FastAPI app (needed for APK on mobile data)
PUBLIC_APP_URL=

SWACHHATA_API_URL=https://api.swachh.city/sbm/v1
SWACHHATA_VENDOR_NAME=
SWACHHATA_ACCESS_KEY=
